# Vertex AI proxy env (api/tutor.js). Copy to .env and fill in real values.
# .env is gitignored; this template is safe to commit.

GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1

# Optional model override. Default in code is gemini-2.5-pro.
# gemini-2.5-flash = ~25x cheaper, lower latency — good for classroom demo.
GEMINI_MODEL=gemini-2.5-pro

# Service-account JSON as a SINGLE LINE (compacted). Role needed: Vertex AI User.
# Generate: gcloud iam service-accounts keys create key.json --iam-account=SA_EMAIL
# Never commit the raw key file.
GCP_SA_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Google Cloud TTS voice-out (api/tts.js) — OPTIONAL online enhancement ---
# Reuses GCP_SA_KEY above. Needs Cloud TTS API enabled (texttospeech.googleapis.com).
# Unset GCP_SA_KEY = client falls back to on-device speechSynthesis (offline floor).
# Voices: fil-PH-Wavenet-A/B/C/D (natural) or fil-PH-Standard-A/B/C/D (cheaper).
TTS_VOICE=fil-PH-Wavenet-A
TTS_LANG=fil-PH

# --- ElevenLabs voice-out (api/tts.js) — OPTIONAL, replaces the Google voice ---
# TTS_PROVIDER=elevenlabs switches api/tts.js over; unset or "google" keeps Google.
# Key and voice are server-only. Missing key or voice -> 501 -> on-device speechSynthesis.
# Models that list Filipino: eleven_flash_v2_5 (fast, default), eleven_multilingual_v2, eleven_v3.
TTS_PROVIDER=google
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional: a different voice per learning mode (each falls back to ELEVENLABS_VOICE_ID).
# Without these, the same voice speaks in every mode but its delivery still changes
# (steadier in Kalma, clearer in Pakinig, warmer in Hakbang; see MODE_VOICE in api/tts.js).
ELEVENLABS_VOICE_ID_KALMA=
ELEVENLABS_VOICE_ID_PAKINIG=
ELEVENLABS_VOICE_ID_HAKBANG=

# --- Content generation (scripts/generate-content.js) — build-time only ---
# Reuses the Vertex creds above; only the npm run gen:content pipeline uses it.
GEN_MODEL=gemini-2.5-flash

# --- Adaptive question sessions (api/questions.js) ---
# GEMINI_API_KEY may be used instead of Vertex credentials. Keep it server-only.
GEMINI_API_KEY=
QUESTION_MODEL=gemini-2.5-flash
QUESTION_RATE_LIMIT=8
# Extra origins allowed to call /api/* cross-origin (comma-separated).
# Same-origin requests are always allowed.
QUESTION_CORS_ORIGINS=

# Optional durable per-IP rate limiting (Upstash Redis REST credentials). Without these, a per-instance memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client-only API origin for a static-only build. Leave blank when the app and
# /api/* share a host.
VITE_QUESTION_API_BASE=
